# Set these in the Vercel project dashboard (or .env.local for dev).
# All are optional during local development — the landing renders without them.

# Meta (Facebook) Pixel ID for ads tracking
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Ads conversion account ID (e.g. AW-XXXXXXX)
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Google Ads conversion label for the Lead event (e.g. abc123XYZ)
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# Where /api/lead POSTs leads. Tally form webhook, Zapier hook, n8n, Sheets via Apps Script — all work.
LEADS_WEBHOOK_URL=

# HMAC secret for signing webhook forwards — must equal WEBHOOK_HMAC_SECRET on
# the pipeline dashboard. Server-only; never expose with NEXT_PUBLIC_.
LEADS_WEBHOOK_SECRET=
