# Set these in the Vercel project dashboard (or .env.local for dev).
# All three are optional during local development — the landing renders without them.

# Meta (Facebook) pixel ID for ads tracking
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics measurement ID (e.g. G-XXXXXXX)
NEXT_PUBLIC_GA_ID=

# Where /api/lead POSTs leads. Tally form webhook, Zapier hook, n8n, Sheets via Apps Script — all work.
LEADS_WEBHOOK_URL=
