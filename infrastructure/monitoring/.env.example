# Copy to infrastructure/monitoring/.env.production on the server checkout.
# That filename is gitignored. Leave ALERT_WEBHOOK_URL empty to run monitors
# without sending anything.

# Published on the host as 127.0.0.1 only. Not added to the tunnel.
UPTIME_KUMA_PORT=13020

# First boot creates this admin. Password must pass Kuma's strength check
# (a long random password). Stored only in Kuma's SQLite after that.
UPTIME_KUMA_USERNAME=
UPTIME_KUMA_PASSWORD=

# Receiver gives a URL, a header name, and the full header value.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_HEADER=Authorization
ALERT_WEBHOOK_HEADER_VALUE=
# Used only when HEADER_VALUE is empty: sends "Bearer <key>".
ALERT_WEBHOOK_KEY=

# Shared with infrastructure/cronjobs/.env.production and the disk timer.
# Push tokens are sha256(secret + ":" + monitor name). Not a Kuma password.
KUMA_PUSH_TOKEN_SECRET=

# Postgres monitor. Defaults match infrastructure/postgres/docker-compose.yml.
POSTGRES_USER=root
POSTGRES_PASSWORD=root

# Newline-separated extra ignore regexes for the log watcher.
LOG_WATCH_IGNORE=

DISK_ALERT_PERCENT=85

# Comma-separated public URLs to add after DNS moves.
# Examples (off today): https://sentinel.kodamalabs.ai/,https://kodamalabs.ai/
EXTRA_PUBLIC_HOSTS=

# Off unless set. Attention calls these on the host, not inside the compose network.
# OLLAMA_HEALTH_URL=http://host.docker.internal:11434/api/tags
# WHISPER_HEALTH_URL=http://host.docker.internal:8083/v1/models
OLLAMA_HEALTH_URL=
WHISPER_HEALTH_URL=
