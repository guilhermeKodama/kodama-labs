{
  "name": "wallex",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "postinstall": "pnpm db:generate",
    "dev": "turbo dev --filter=!@infrastructure/postgres",
    "dev:db": "turbo dev --filter=@infrastructure/postgres",
    "db:up": "pnpm --filter @infrastructure/postgres start",
    "db:migrate": "pnpm --filter @wallex/capital exec prisma migrate deploy && pnpm --filter @wallex/sentinel exec prisma migrate deploy && pnpm --filter @wallex/pipeline exec prisma migrate deploy",
    "setup:local": "pnpm db:up && pnpm db:migrate",
    "dev:docs": "turbo dev --filter=@wallex/docs",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "db:reset": "turbo db:reset",
    "db:dump": "bash infrastructure/postgres/db-backup.sh dump",
    "db:restore": "bash infrastructure/postgres/db-backup.sh restore",
    "db:backups": "bash infrastructure/postgres/db-backup.sh list",
    "db:generate": "pnpm --filter @wallex/capital exec prisma generate && pnpm --filter @wallex/sentinel exec prisma generate && pnpm --filter @wallex/pipeline exec prisma generate",
    "test": "turbo test --filter=@wallex/capital",
    "new:idea": "node scripts/new-idea.mjs",
    "sync:ideas": "node scripts/sync-ideas.mjs"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "js-yaml": "^4.1.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.5",
    "typescript": "^5.4.5"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^18.3.3",
      "@types/react-dom": "^18.3.0",
      "confbox": "0.2.1"
    }
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@9.15.4"
}
