#!/bin/sh

echo "🔍 Running lint and typecheck before push..."

# Regenerate Prisma clients (gitignored; required for typecheck)
echo "🗄️  Generating Prisma clients..."
pnpm db:generate
GENERATE_EXIT_CODE=$?

if [ $GENERATE_EXIT_CODE -ne 0 ]; then
  echo "❌ Prisma generate failed. Push aborted."
  exit 1
fi

# Run lint
echo "📝 Running lint..."
pnpm lint
LINT_EXIT_CODE=$?

if [ $LINT_EXIT_CODE -ne 0 ]; then
  echo "❌ Lint failed. Push aborted."
  exit 1
fi

echo "✅ Lint passed!"

# Run typecheck
echo "🔎 Running typecheck..."
pnpm typecheck
TYPECHECK_EXIT_CODE=$?

if [ $TYPECHECK_EXIT_CODE -ne 0 ]; then
  echo "❌ Typecheck failed. Push aborted."
  exit 1
fi

echo "✅ Typecheck passed!"

# Run tests
echo "🧪 Running tests..."
pnpm test
TEST_EXIT_CODE=$?

if [ $TEST_EXIT_CODE -ne 0 ]; then
  echo "❌ Tests failed. Push aborted."
  exit 1
fi

echo "✅ Tests passed!"
echo "🚀 All checks passed. Pushing..."
