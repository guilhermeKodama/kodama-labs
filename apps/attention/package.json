{
  "name": "@wallex/attention",
  "version": "0.1.0",
  "description": "POC: push delivery through iOS Focus + WhatsApp metadata soak test",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev --port 3005",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start --port 3005",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset --force",
    "worker:beacon": "node --env-file=.env --import tsx src/worker/beacon.ts",
    "worker:whatsapp:build": "esbuild src/worker/whatsapp.ts --bundle --platform=node --format=esm --packages=external --external:./src/generated/prisma/index.js --outfile=dist/worker-whatsapp.mjs",
    "worker:whatsapp": "pnpm run worker:whatsapp:build && node --env-file=.env dist/worker-whatsapp.mjs",
    "worker:maintenance": "node --env-file=.env --import tsx src/worker/maintenance.ts",
    "worker:jobs": "node --env-file=.env --import tsx src/worker/jobs.ts"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@prisma/client": "^6.0.0",
    "@t3-oss/env-nextjs": "^0.11.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "next": "16.2.9",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^6.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
