[Unit]
Description=Attention — Next.js web (PWA + API)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_PATH__/apps/attention
ExecStart=pnpm run start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
