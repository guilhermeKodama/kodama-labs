[Unit]
Description=Attention — Cloudflare Tunnel
After=network-online.target attention-web.service
Wants=network-online.target
Requires=attention-web.service

[Service]
Type=simple
WorkingDirectory=/home/kodama/Documents/Github/kodama-labs/apps/attention
Environment=PATH=/home/linuxbrew/.linuxbrew/opt/node@24/bin:/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:/home/kodama/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/kodama/.local/bin/cloudflared tunnel --config /home/kodama/Documents/Github/kodama-labs/apps/attention/cloudflared/config.yml run attention
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
