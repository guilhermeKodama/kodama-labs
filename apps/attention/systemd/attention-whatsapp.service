[Unit]
Description=Attention — WhatsApp metadata worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_PATH__/apps/attention
ExecStart=pnpm run worker:whatsapp
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
