generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MessageDirection {
  IN
  OUT
}

model PushSubscription {
  id          String    @id @default(cuid())
  endpoint    String    @unique
  p256dh      String
  auth        String
  deviceLabel String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  deadAt      DateTime?

  beacons Beacon[]

  @@index([deadAt])
}

model Beacon {
  id             String    @id @default(cuid())
  seq            Int       @default(autoincrement())
  subscriptionId String
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  sentAt         DateTime  @default(now())
  receivedAt     DateTime?
  ackedAt        DateTime?
  sendError      String?

  @@index([subscriptionId, sentAt])
  @@index([sentAt])
}

model FocusWindow {
  id       String    @id @default(cuid())
  label    String
  startsAt DateTime  @default(now())
  endsAt   DateTime?

  @@index([startsAt])
}

// Congelada a partir da Etapa 1 — o worker parou de escrever aqui. Fica como
// artefato do soak de entrega até a migration de limpeza da Etapa 6.
model WhatsAppMessageMeta {
  id         String            @id @default(cuid())
  chatIdHash String
  senderHash String
  isGroup    Boolean
  direction  MessageDirection
  length     Int
  occurredAt DateTime
  createdAt  DateTime          @default(now())

  @@index([chatIdHash, occurredAt])
}

model Chat {
  id            String    @id @default(cuid())
  waChatId      String    @unique
  name          String?
  isGroup       Boolean
  lastMessageAt DateTime?
  backfilledAt  DateTime?
  createdAt     DateTime  @default(now())

  messages Message[]
}

model Contact {
  id          String   @id @default(cuid())
  waContactId String   @unique
  name        String?
  pushname    String?
  isMyContact Boolean  @default(false)
  createdAt   DateTime @default(now())

  messages Message[]
}

model Message {
  id                String           @id @default(cuid())
  waMessageId       String           @unique
  chatId            String
  chat              Chat             @relation(fields: [chatId], references: [id])
  senderContactId   String?
  sender            Contact?         @relation(fields: [senderContactId], references: [id])
  direction         MessageDirection
  type              String
  body              String?
  hasMedia          Boolean          @default(false)
  mentionedMe       Boolean          @default(false)
  quotedWaMessageId String?
  occurredAt        DateTime
  createdAt         DateTime         @default(now())

  @@index([chatId, occurredAt])
  @@index([occurredAt])
}

model IntegrationStatus {
  id               String    @id @default(cuid())
  channel          String    @unique
  state            String
  lastEventAt      DateTime  @default(now())
  lastMessageAt    DateTime?
  qrPayload        String?
  sessionStartedAt DateTime?
  lastError        String?
}
