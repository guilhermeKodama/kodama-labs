DATABASE_URL="postgresql://root:root@localhost:5433/attention"
DIRECT_URL="postgresql://root:root@localhost:5433/attention"

# Gerar com: pnpm exec web-push generate-vapid-keys
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:guilherme.kodama@gmail.com"

# Qualquer string secreta — usada para hashear remetente/chat do WhatsApp
WHATSAPP_HASH_SALT="troque-este-valor"

# Opcional: onde a sessão do WhatsApp (Baileys multi-file auth state) fica salva. Default é um
# caminho absoluto fora do repo — a sessão não pode depender de qual checkout/worktree roda o código.
# WHATSAPP_AUTH_DIR="/home/kodama/.local/share/attention/baileys-auth"

# Dias que o corpo da mensagem fica guardado antes de ser purgado (metadados/scores ficam pra sempre)
# RETENTION_DAYS=7

# Triagem e rascunhos de resposta rodam localmente via Ollama (GPU) — sem API key.
# OLLAMA_API_URL="http://localhost:11434"
# TRIAGE_MODEL="gemma4:12b"
# DRAFT_MODEL="gemma4:12b"
# LLM_TIMEOUT_MS=120000

# Janelas do digest (America/Sao_Paulo) e teto diário do nível "agora" (furo de DND)
# DIGEST_WINDOWS="08:00,13:00,18:00,21:00"
# AGORA_MAX_PER_DAY=5

NEXT_PUBLIC_APP_URL="http://localhost:3005"
