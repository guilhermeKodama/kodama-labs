generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// ENUMS
// ============================================

enum EntityType {
  business
  personal
}

enum TransactionType {
  income
  expense
  investment
}

enum TransferDirection {
  profit_distribution
  capital_injection
  reimbursement
  investment_deposit
  investment_withdrawal
}

enum RecurrenceFrequency {
  daily
  weekly
  monthly
  yearly
}

enum BudgetPeriod {
  monthly
  yearly
}

enum BillStatus {
  pending
  paid
  overdue
}

enum AssetClass {
  stocks
  fii
  etf
  bdr
  fixed_income
  crypto
  savings
  international_stocks
  international_etf
}

enum FixedIncomeSubType {
  cdb
  rdb
  lci
  lca
  cdi
  tesouro_selic
  tesouro_ipca
  tesouro_prefixado
  debenture
}

enum InvestmentTransactionType {
  buy
  sell
  dividend
  yield_payment
  split
  deposit
  withdrawal
  adjustment
}

// ============================================
// USER
// ============================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  baseCurrency String   @default("USD")
  theme        String   @default("system") // light, dark, system
  dateFormat   String   @default("yyyy-MM-dd")
  numberFormat String   @default("en-US") // en-US, pt-BR, de-DE
  timezone     String   @default("America/Sao_Paulo")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  businesses                Business[]
  personalAccount           PersonalAccount?
  categories                Category[]
  currencies                Currency[]
  sessions                  Session[]
  investmentAccounts        InvestmentAccount[]
  merchantCategoryMappings  MerchantCategoryMapping[]

  @@map("users")
}

// ============================================
// SESSION
// ============================================

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================
// BUSINESS
// ============================================

model Business {
  id              String   @id @default(uuid())
  userId          String
  name            String
  description     String?
  defaultCurrency String   @default("USD")
  color           String?
  taxRate         Float    @default(0) // Tax rate percentage
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
  transfersFrom         Transfer[]             @relation("TransferFrom")
  transfersTo           Transfer[]             @relation("TransferTo")
  recurringTransfersFrom RecurringTransfer[]   @relation("RecurringTransferFrom")
  recurringTransfersTo   RecurringTransfer[]   @relation("RecurringTransferTo")
  creditCards           CreditCard[]
  investmentAccounts   InvestmentAccount[]
  statementImports     StatementImport[]

  @@index([userId])
  @@map("businesses")
}

// ============================================
// PERSONAL ACCOUNT
// ============================================

model PersonalAccount {
  id              String   @id @default(uuid())
  userId          String   @unique
  defaultCurrency String   @default("USD")
  taxRate         Float    @default(0) // Tax rate percentage
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
  transfersFrom         Transfer[]             @relation("PersonalTransferFrom")
  transfersTo           Transfer[]             @relation("PersonalTransferTo")
  recurringTransfersFrom RecurringTransfer[]   @relation("PersonalRecurringTransferFrom")
  recurringTransfersTo   RecurringTransfer[]   @relation("PersonalRecurringTransferTo")
  creditCards           CreditCard[]
  investmentAccounts   InvestmentAccount[]
  statementImports     StatementImport[]

  @@map("personal_accounts")
}

// ============================================
// TRANSACTION
// ============================================

model Transaction {
  id                     String          @id @default(uuid())
  entityType             EntityType
  type                   TransactionType
  amount                 Float
  currency               String
  exchangeRate           Float           @default(1)
  description            String
  category               String
  date                   DateTime
  isTaxDeductible        Boolean         @default(false)
  recurringTransactionId String?
  externalId             String?
  statementImportId      String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  // Relations - polymorphic association
  businessId        String?
  business          Business?             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  personalAccountId String?
  personalAccount   PersonalAccount?      @relation(fields: [personalAccountId], references: [id], onDelete: Cascade)
  recurringTransaction RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  statementImport   StatementImport?      @relation(fields: [statementImportId], references: [id], onDelete: SetNull)
  creditCardBills   CreditCardBill[]
  linkedInvestmentTransaction InvestmentTransaction?

  @@index([businessId])
  @@index([personalAccountId])
  @@index([entityType])
  @@index([type])
  @@index([date])
  @@index([category])
  @@index([externalId])
  @@map("transactions")
}

// ============================================
// TRANSFER
// ============================================

model Transfer {
  id              String            @id @default(uuid())
  fromEntityType  EntityType
  toEntityType    EntityType
  direction       TransferDirection
  amount          Float
  currency        String
  exchangeRate    Float             @default(1)
  description     String?
  date            DateTime
  recurringTransferId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations - polymorphic association for from/to entities
  fromBusinessId        String?
  fromBusiness          Business?        @relation("TransferFrom", fields: [fromBusinessId], references: [id], onDelete: Cascade)
  fromPersonalAccountId String?
  fromPersonalAccount   PersonalAccount? @relation("PersonalTransferFrom", fields: [fromPersonalAccountId], references: [id], onDelete: Cascade)
  toBusinessId          String?
  toBusiness            Business?        @relation("TransferTo", fields: [toBusinessId], references: [id], onDelete: Cascade)
  toPersonalAccountId   String?
  toPersonalAccount     PersonalAccount? @relation("PersonalTransferTo", fields: [toPersonalAccountId], references: [id], onDelete: Cascade)
  recurringTransfer     RecurringTransfer? @relation("GeneratedFromRecurring", fields: [recurringTransferId], references: [id], onDelete: SetNull)

  // Investment account references (for investment_deposit / investment_withdrawal)
  toInvestmentAccountId   String?
  toInvestmentAccount     InvestmentAccount? @relation("TransferToInvestment", fields: [toInvestmentAccountId], references: [id], onDelete: Cascade)
  fromInvestmentAccountId String?
  fromInvestmentAccount   InvestmentAccount? @relation("TransferFromInvestment", fields: [fromInvestmentAccountId], references: [id], onDelete: Cascade)

  @@index([fromBusinessId])
  @@index([fromPersonalAccountId])
  @@index([toBusinessId])
  @@index([toPersonalAccountId])
  @@index([toInvestmentAccountId])
  @@index([fromInvestmentAccountId])
  @@index([date])
  @@index([recurringTransferId])
  @@map("transfers")
}

// ============================================
// RECURRING TRANSFER
// ============================================

model RecurringTransfer {
  id                String              @id @default(uuid())
  fromEntityType    EntityType
  toEntityType      EntityType
  direction         TransferDirection
  amount            Float
  currency          String
  exchangeRate      Float               @default(1)
  description       String?
  frequency         RecurrenceFrequency
  startDate         DateTime
  endDate           DateTime?
  nextDueDate       DateTime
  lastGeneratedDate DateTime?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations - polymorphic association for from/to entities
  fromBusinessId        String?
  fromBusiness          Business?        @relation("RecurringTransferFrom", fields: [fromBusinessId], references: [id], onDelete: Cascade)
  fromPersonalAccountId String?
  fromPersonalAccount   PersonalAccount? @relation("PersonalRecurringTransferFrom", fields: [fromPersonalAccountId], references: [id], onDelete: Cascade)
  toBusinessId          String?
  toBusiness            Business?        @relation("RecurringTransferTo", fields: [toBusinessId], references: [id], onDelete: Cascade)
  toPersonalAccountId   String?
  toPersonalAccount     PersonalAccount? @relation("PersonalRecurringTransferTo", fields: [toPersonalAccountId], references: [id], onDelete: Cascade)

  // Generated transfers
  generatedTransfers Transfer[] @relation("GeneratedFromRecurring")

  @@index([fromBusinessId])
  @@index([fromPersonalAccountId])
  @@index([toBusinessId])
  @@index([toPersonalAccountId])
  @@index([isActive])
  @@index([nextDueDate])
  @@map("recurring_transfers")
}

// ============================================
// RECURRING TRANSACTION
// ============================================

model RecurringTransaction {
  id                String              @id @default(uuid())
  entityType        EntityType
  type              TransactionType
  amount            Float
  currency          String
  exchangeRate      Float               @default(1)
  description       String
  category          String
  frequency         RecurrenceFrequency
  startDate         DateTime
  endDate           DateTime?
  nextDueDate       DateTime
  lastGeneratedDate DateTime?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations - polymorphic association
  businessId        String?
  business          Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  personalAccountId String?
  personalAccount   PersonalAccount? @relation(fields: [personalAccountId], references: [id], onDelete: Cascade)
  
  // Generated transactions
  generatedTransactions Transaction[]

  @@index([businessId])
  @@index([personalAccountId])
  @@index([entityType])
  @@index([isActive])
  @@index([nextDueDate])
  @@map("recurring_transactions")
}

// ============================================
// BUDGET
// ============================================

model Budget {
  id         String       @id @default(uuid())
  entityType EntityType
  category   String
  amount     Float
  currency   String
  period     BudgetPeriod
  year       Int
  month      Int?         // 1-12 for monthly budgets
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  // Relations - polymorphic association
  businessId        String?
  business          Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  personalAccountId String?
  personalAccount   PersonalAccount? @relation(fields: [personalAccountId], references: [id], onDelete: Cascade)

  @@unique([businessId, category, period, year, month])
  @@unique([personalAccountId, category, period, year, month])
  @@index([businessId])
  @@index([personalAccountId])
  @@index([entityType])
  @@index([year, month])
  @@map("budgets")
}

// ============================================
// CATEGORY
// ============================================

model Category {
  id        String          @id @default(uuid())
  userId    String
  name      String
  type      TransactionType
  color     String?
  icon      String?
  isDefault Boolean         @default(false)
  isSystem  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name, type])
  @@index([userId])
  @@index([type])
  @@map("categories")
}

// ============================================
// CREDIT CARD
// ============================================

model CreditCard {
  id                String     @id @default(uuid())
  entityType        EntityType
  bankName          String
  lastFourDigits    String
  nickname          String?
  creditLimit       Float
  closingDay        Int        // 1-31
  dueDay            Int        // 1-31
  color             String     @default("#3B82F6")
  currency          String
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Relations - polymorphic association
  businessId        String?
  business          Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  personalAccountId String?
  personalAccount   PersonalAccount? @relation(fields: [personalAccountId], references: [id], onDelete: Cascade)

  bills             CreditCardBill[]
  installments      Installment[]

  @@index([businessId])
  @@index([personalAccountId])
  @@index([entityType])
  @@index([isActive])
  @@map("credit_cards")
}

// ============================================
// CREDIT CARD BILL
// ============================================

model CreditCardBill {
  id                   String     @id @default(uuid())
  creditCardId         String
  transactionId        String?    // Links to an expense Transaction (optional)
  closingDate          DateTime
  dueDate              DateTime
  totalAmount          Float
  status               BillStatus @default(pending)
  categorizationStatus String     @default("pending") // pending, processing, completed, failed
  csvFileName          String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  // Relations
  creditCard       CreditCard       @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  transaction      Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  billTransactions BillTransaction[]

  @@index([creditCardId])
  @@index([transactionId])
  @@index([status])
  @@index([dueDate])
  @@index([categorizationStatus])
  @@map("credit_card_bills")
}

// ============================================
// BILL TRANSACTION (line items from CSV)
// ============================================

model BillTransaction {
  id                  String   @id @default(uuid())
  billId              String
  category            String
  transactionDate     DateTime
  description         String
  merchantName        String?
  amount              Float
  installmentNumber   Int?
  totalInstallments   Int?
  isAutoCategorized   Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  bill        CreditCardBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  installment Installment?

  @@index([billId])
  @@index([category])
  @@index([transactionDate])
  @@map("bill_transactions")
}

// ============================================
// INSTALLMENT (parcela tracking)
// ============================================

model Installment {
  id                  String   @id @default(uuid())
  creditCardId        String
  billTransactionId   String   @unique
  description         String
  totalAmount         Float
  totalInstallments   Int
  paidInstallments    Int      @default(0)
  startDate           DateTime
  installmentAmount   Float
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  creditCard      CreditCard      @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  billTransaction BillTransaction @relation(fields: [billTransactionId], references: [id], onDelete: Cascade)

  @@index([creditCardId])
  @@index([isActive])
  @@map("installments")
}

// ============================================
// INVESTMENT ACCOUNT (broker/platform)
// ============================================

model InvestmentAccount {
  id              String     @id @default(uuid())
  userId          String
  name            String     // e.g., "Interactive Brokers", "NuInvest", "Tesouro Direto"
  broker          String?    // Broker identifier
  entityType      EntityType
  currency        String     @default("BRL")
  cashBalance     Float      @default(0) // Available cash in the account (not invested)
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations - polymorphic association
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId        String?
  business          Business?           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  personalAccountId String?
  personalAccount   PersonalAccount?    @relation(fields: [personalAccountId], references: [id], onDelete: Cascade)
  holdings          InvestmentHolding[]
  transfersTo       Transfer[]          @relation("TransferToInvestment")
  transfersFrom     Transfer[]          @relation("TransferFromInvestment")

  @@index([userId])
  @@index([entityType])
  @@index([businessId])
  @@index([personalAccountId])
  @@map("investment_accounts")
}

// ============================================
// INVESTMENT HOLDING (position/asset)
// ============================================

model InvestmentHolding {
  id              String              @id @default(uuid())
  accountId       String
  assetClass      AssetClass
  subType         FixedIncomeSubType? // Only for fixed_income assets
  ticker          String?             // For stocks, FIIs, crypto, ETFs (e.g., PETR4, HGLG11, BTC)
  name            String              // Descriptive name (e.g., "CDB Nubank 120% CDI")
  currency        String              @default("BRL")
  currentQuantity Float               @default(0)
  averageCost     Float               @default(0)
  totalInvested   Float               @default(0)
  currentPrice    Float?              // Latest market price per unit
  lastPriceUpdate DateTime?           // When the price was last fetched
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // Relations
  account      InvestmentAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions InvestmentTransaction[]

  @@index([accountId])
  @@index([assetClass])
  @@index([ticker])
  @@index([isActive])
  @@map("investment_holdings")
}

// ============================================
// INVESTMENT TRANSACTION (buy/sell/dividend/yield)
// ============================================

model InvestmentTransaction {
  id           String                    @id @default(uuid())
  holdingId    String
  type         InvestmentTransactionType
  quantity     Float?                    // Number of units (for stocks, crypto, FIIs)
  pricePerUnit Float?                    // Price paid per unit (for stocks, crypto, FIIs)
  totalAmount  Float                     // Total cash value of the transaction
  fees         Float                     @default(0) // Brokerage fees, taxes
  date         DateTime
  notes        String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  // Relations
  holding InvestmentHolding @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  linkedTransactionId String?   @unique
  linkedTransaction   Transaction? @relation(fields: [linkedTransactionId], references: [id], onDelete: SetNull)

  @@index([holdingId])
  @@index([type])
  @@index([date])
  @@map("investment_transactions")
}

// ============================================
// CURRENCY
// ============================================

model Currency {
  id         String   @id @default(uuid())
  userId     String
  code       String   // ISO 4217 code (e.g., USD, EUR, BRL)
  name       String
  symbol     String
  manualRate Float    @default(1) // Rate relative to user's base currency
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId])
  @@map("currencies")
}

// ============================================
// MERCHANT CATEGORY MAPPING (learned categories)
// ============================================

model MerchantCategoryMapping {
  id                    String   @id @default(uuid())
  userId                String
  normalizedDescription String
  category              String
  source                String   @default("ai") // "manual" | "ai"
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedDescription])
  @@index([userId])
  @@map("merchant_category_mappings")
}

// ============================================
// STATEMENT IMPORT (bulk import job tracker)
// ============================================

model StatementImport {
  id                   String     @id @default(uuid())
  userId               String
  entityType           EntityType
  bankName             String?
  fileName             String?
  transactionCount     Int
  ledgerBalance        Float?
  ledgerCurrency       String?
  categorizationStatus String     @default("pending") // pending, processing, completed, failed
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  // Relations - polymorphic association
  businessId        String?
  business          Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  personalAccountId String?
  personalAccount   PersonalAccount? @relation(fields: [personalAccountId], references: [id], onDelete: Cascade)
  transactions      Transaction[]

  @@index([userId])
  @@index([categorizationStatus])
  @@index([businessId])
  @@index([personalAccountId])
  @@map("statement_imports")
}
