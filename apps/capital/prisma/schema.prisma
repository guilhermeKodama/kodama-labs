generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// ENUMS
// ============================================

enum EntityType {
  business
  personal
}

enum TransactionType {
  income
  expense
  investment
}

enum TransferDirection {
  profit_distribution
  capital_injection
  reimbursement
  investment_deposit
  investment_withdrawal
}

enum RecurrenceFrequency {
  daily
  weekly
  monthly
  yearly
}

enum BudgetPeriod {
  monthly
  yearly
}

enum BillStatus {
  pending
  paid
  overdue
}

enum AssetClass {
  stocks
  fii
  etf
  bdr
  fixed_income
  crypto
  savings
  international_stocks
  international_etf
}

enum FixedIncomeSubType {
  cdb
  rdb
  lci
  lca
  cdi
  tesouro_selic
  tesouro_ipca
  tesouro_prefixado
  debenture
}

enum InvestmentTransactionType {
  buy
  sell
  dividend
  yield_payment
  split
  deposit
  withdrawal
  adjustment
}

enum AttachmentKind {
  BILL
  RECEIPT
  TRANSFER_RECEIPT
}

enum AgentConversationStatus {
  active
  archived
}

enum AgentTurnStatus {
  running
  completed
  failed
  cancelled
}

enum ImportPlanKind {
  import
  revert
}

enum ImportPlanStatus {
  proposed
  confirmed
  committed
  rejected
  superseded
  reverted
}

enum StatementFileType {
  ofx
  csv
  pdf
}

// ============================================
// USER
// ============================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  baseCurrency String   @default("USD")
  theme        String   @default("system") // light, dark, system
  dateFormat   String   @default("yyyy-MM-dd")
  numberFormat String   @default("en-US") // en-US, pt-BR, de-DE
  timezone     String   @default("America/Sao_Paulo")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  businesses               Business[]
  personalAccount          PersonalAccount?
  categories               Category[]
  currencies               Currency[]
  sessions                 Session[]
  investmentAccounts       InvestmentAccount[]
  merchantCategoryMappings MerchantCategoryMapping[]
  fireGoal                 FireGoal?
  agentConversations       AgentConversation[]

  @@map("users")
}

// ============================================
// FIRE (Financial Independence / Liberdade Financeira)
// ============================================

// A user's single FIRE plan. Lean/Fat/Coast/Barista are computed views of this
// plan, not separate rows. `phases` is a value object (array of contribution
// phases) validated by Zod at the API boundary. All inputs are editable.
model FireGoal {
  id                    String   @id @default(uuid())
  userId                String   @unique
  name                  String?
  targetMonthlyIncome   Float // primary input: desired monthly income in retirement (today's money)
  safeWithdrawalRate    Float    @default(0.035)
  nominalAnnualReturn   Float    @default(0.10)
  annualInflation       Float    @default(0.045) // IPCA; the real return is derived from these two
  monthlyIncome         Float? // optional, for savings-rate reporting
  planningMode          String   @default("by_date") // by_date | by_contribution
  targetYear            Int? // used in by_date mode
  phaseProfile          String   @default("front_loaded") // front_loaded | constant | back_loaded | custom
  phases                Json // [{ order, label, fromMonth, toMonth | null, monthlyContribution }]
  baristaMonthlyIncome  Float?
  coastStopYear         Int?
  leanMultiplier        Float    @default(0.7)
  fatMultiplier         Float    @default(1.6)
  includeEntityBalances Boolean  @default(false) // base = portfolio + investment cash
  includeBusinessInvestments Boolean @default(false) // also count business-entity investments
  currency              String   @default("BRL")
  // Whole-life modelling (ProjectionLab-style): accumulate then withdraw.
  currentAge            Int? // anchors the age axis + decumulation horizon
  retirementAge         Int? // optional explicit retirement age (else retire at FIRE)
  lifeExpectancyAge     Int      @default(95)
  annualVolatility      Float    @default(0.12) // sd of real annual return, for Monte Carlo
  milestones            Json     @default("[]") // MilestoneDef[]: { id, name, type, value }
  withdrawalStrategy    String   @default("perpetuity") // perpetuity (live off yield) | depletion (spend down to ~0 by life expectancy)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots FireSnapshot[]

  @@map("fire_goals")
}

// Forward-only monthly progress snapshot. Portfolio market value can only be
// observed in the present (prices are spot, with no historical series), so
// history is recorded going forward, one row per calendar month.
model FireSnapshot {
  id                     String    @id @default(uuid())
  goalId                 String
  period                 Int // year*100 + month (e.g. 202606) — dedupe key
  snapshotDate           DateTime
  currentInvested        Float
  currentMonthlyExpenses Float // for tracking the income-target gap over time
  fireNumber             Float
  progress               Float // currentInvested / fireNumber
  monthsToFire           Int?
  projectedFireDate      DateTime?
  createdAt              DateTime  @default(now())

  goal FireGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, period])
  @@index([goalId, period])
  @@map("fire_snapshots")
}

// ============================================
// SESSION
// ============================================

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================
// BUSINESS
// ============================================

model Business {
  id              String   @id @default(uuid())
  userId          String
  name            String
  description     String?
  defaultCurrency String   @default("USD")
  color           String?
  taxRate         Float    @default(0) // Tax rate percentage
  initialBalance  Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions           Transaction[]
  budgets                Budget[]
  recurringTransactions  RecurringTransaction[]
  transfersFrom          Transfer[]             @relation("TransferFrom")
  transfersTo            Transfer[]             @relation("TransferTo")
  recurringTransfersFrom RecurringTransfer[]    @relation("RecurringTransferFrom")
  recurringTransfersTo   RecurringTransfer[]    @relation("RecurringTransferTo")
  creditCards            CreditCard[]
  investmentAccounts     InvestmentAccount[]
  statementImports       StatementImport[]

  @@index([userId])
  @@map("businesses")
}

// ============================================
// PERSONAL ACCOUNT
// ============================================

model PersonalAccount {
  id              String   @id @default(uuid())
  userId          String   @unique
  defaultCurrency String   @default("USD")
  taxRate         Float    @default(0) // Tax rate percentage
  initialBalance  Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions           Transaction[]
  budgets                Budget[]
  recurringTransactions  RecurringTransaction[]
  transfersFrom          Transfer[]             @relation("PersonalTransferFrom")
  transfersTo            Transfer[]             @relation("PersonalTransferTo")
  recurringTransfersFrom RecurringTransfer[]    @relation("PersonalRecurringTransferFrom")
  recurringTransfersTo   RecurringTransfer[]    @relation("PersonalRecurringTransferTo")
  creditCards            CreditCard[]
  investmentAccounts     InvestmentAccount[]
  statementImports       StatementImport[]

  @@map("personal_accounts")
}

// ============================================
// TRANSACTION
// ============================================

model Transaction {
  id                     String          @id @default(uuid())
  entityType             EntityType
  type                   TransactionType
  amount                 Float
  currency               String
  exchangeRate           Float           @default(1)
  description            String
  category               String
  date                   DateTime
  isTaxDeductible        Boolean         @default(false)
  recurringTransactionId String?
  externalId             String?
  statementImportId      String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  // Relations - polymorphic association
  businessId                  String?
  business                    Business?              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  personalAccountId           String?
  personalAccount             PersonalAccount?       @relation(fields: [personalAccountId], references: [id], onDelete: Cascade)
  recurringTransaction        RecurringTransaction?  @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  statementImport             StatementImport?       @relation(fields: [statementImportId], references: [id], onDelete: SetNull)
  creditCardBills             CreditCardBill[]
  linkedInvestmentTransaction InvestmentTransaction?
  attachments                 Attachment[]

  @@unique([externalId, businessId])
  @@unique([externalId, personalAccountId])
  @@index([businessId])
  @@index([personalAccountId])
  @@index([entityType])
  @@index([type])
  @@index([date])
  @@index([category])
  @@index([externalId])
  @@map("transactions")
}

// ============================================
// TRANSFER
// ============================================

model Transfer {
  id                  String            @id @default(uuid())
  fromEntityType      EntityType
  toEntityType        EntityType
  direction           TransferDirection
  amount              Float
  currency            String
  exchangeRate        Float             @default(1)
  description         String?
  date                DateTime
  externalId          String?
  recurringTransferId String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Relations - polymorphic association for from/to entities
  fromBusinessId        String?
  fromBusiness          Business?          @relation("TransferFrom", fields: [fromBusinessId], references: [id], onDelete: Cascade)
  fromPersonalAccountId String?
  fromPersonalAccount   PersonalAccount?   @relation("PersonalTransferFrom", fields: [fromPersonalAccountId], references: [id], onDelete: Cascade)
  toBusinessId          String?
  toBusiness            Business?          @relation("TransferTo", fields: [toBusinessId], references: [id], onDelete: Cascade)
  toPersonalAccountId   String?
  toPersonalAccount     PersonalAccount?   @relation("PersonalTransferTo", fields: [toPersonalAccountId], references: [id], onDelete: Cascade)
  recurringTransfer     RecurringTransfer? @relation("GeneratedFromRecurring", fields: [recurringTransferId], references: [id], onDelete: SetNull)

  // Investment account references (for investment_deposit / investment_withdrawal)
  toInvestmentAccountId   String?
  toInvestmentAccount     InvestmentAccount? @relation("TransferToInvestment", fields: [toInvestmentAccountId], references: [id], onDelete: Cascade)
  fromInvestmentAccountId String?
  fromInvestmentAccount   InvestmentAccount? @relation("TransferFromInvestment", fields: [fromInvestmentAccountId], references: [id], onDelete: Cascade)

  attachments Attachment[]

  @@index([fromBusinessId])
  @@index([fromPersonalAccountId])
  @@index([toBusinessId])
  @@index([toPersonalAccountId])
  @@index([toInvestmentAccountId])
  @@index([fromInvestmentAccountId])
  @@index([date])
  @@index([externalId])
  @@index([recurringTransferId])
  @@map("transfers")
}

// ============================================
// RECURRING TRANSFER
// ============================================

model RecurringTransfer {
  id                String              @id @default(uuid())
  fromEntityType    EntityType
  toEntityType      EntityType
  direction         TransferDirection
  amount            Float
  currency          String
  exchangeRate      Float               @default(1)
  description       String?
  frequency         RecurrenceFrequency
  startDate         DateTime
  endDate           DateTime?
  nextDueDate       DateTime
  lastGeneratedDate DateTime?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations - polymorphic association for from/to entities
  fromBusinessId        String?
  fromBusiness          Business?        @relation("RecurringTransferFrom", fields: [fromBusinessId], references: [id], onDelete: Cascade)
  fromPersonalAccountId String?
  fromPersonalAccount   PersonalAccount? @relation("PersonalRecurringTransferFrom", fields: [fromPersonalAccountId], references: [id], onDelete: Cascade)
  toBusinessId          String?
  toBusiness            Business?        @relation("RecurringTransferTo", fields: [toBusinessId], references: [id], onDelete: Cascade)
  toPersonalAccountId   String?
  toPersonalAccount     PersonalAccount? @relation("PersonalRecurringTransferTo", fields: [toPersonalAccountId], references: [id], onDelete: Cascade)

  // Generated transfers
  generatedTransfers Transfer[] @relation("GeneratedFromRecurring")

  attachments Attachment[]

  @@index([fromBusinessId])
  @@index([fromPersonalAccountId])
  @@index([toBusinessId])
  @@index([toPersonalAccountId])
  @@index([isActive])
  @@index([nextDueDate])
  @@map("recurring_transfers")
}

// ============================================
// RECURRING TRANSACTION
// ============================================

model RecurringTransaction {
  id                String              @id @default(uuid())
  entityType        EntityType
  type              TransactionType
  amount            Float
  currency          String
  exchangeRate      Float               @default(1)
  description       String
  category          String
  frequency         RecurrenceFrequency
  startDate         DateTime
  endDate           DateTime?
  nextDueDate       DateTime
  lastGeneratedDate DateTime?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations - polymorphic association
  businessId        String?
  business          Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  personalAccountId String?
  personalAccount   PersonalAccount? @relation(fields: [personalAccountId], references: [id], onDelete: Cascade)

  // Generated transactions
  generatedTransactions Transaction[]

  attachments Attachment[]

  @@index([businessId])
  @@index([personalAccountId])
  @@index([entityType])
  @@index([isActive])
  @@index([nextDueDate])
  @@map("recurring_transactions")
}

// ============================================
// BUDGET
// ============================================

model Budget {
  id         String       @id @default(uuid())
  entityType EntityType
  category   String
  amount     Float
  currency   String
  period     BudgetPeriod
  year       Int
  month      Int? // 1-12 for monthly budgets
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  // Relations - polymorphic association
  businessId        String?
  business          Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  personalAccountId String?
  personalAccount   PersonalAccount? @relation(fields: [personalAccountId], references: [id], onDelete: Cascade)

  @@unique([businessId, category, period, year, month])
  @@unique([personalAccountId, category, period, year, month])
  @@index([businessId])
  @@index([personalAccountId])
  @@index([entityType])
  @@index([year, month])
  @@map("budgets")
}

// ============================================
// CATEGORY
// ============================================

model Category {
  id        String          @id @default(uuid())
  userId    String
  name      String
  type      TransactionType
  color     String?
  icon      String?
  isDefault Boolean         @default(false)
  isSystem  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name, type])
  @@index([userId])
  @@index([type])
  @@map("categories")
}

// ============================================
// CREDIT CARD
// ============================================

model CreditCard {
  id             String     @id @default(uuid())
  entityType     EntityType
  bankName       String
  lastFourDigits String
  nickname       String?
  creditLimit    Float
  closingDay     Int // 1-31
  dueDay         Int // 1-31
  color          String     @default("#3B82F6")
  currency       String
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relations - polymorphic association
  businessId        String?
  business          Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  personalAccountId String?
  personalAccount   PersonalAccount? @relation(fields: [personalAccountId], references: [id], onDelete: Cascade)

  bills        CreditCardBill[]
  installments Installment[]

  @@index([businessId])
  @@index([personalAccountId])
  @@index([entityType])
  @@index([isActive])
  @@map("credit_cards")
}

// ============================================
// CREDIT CARD BILL
// ============================================

model CreditCardBill {
  id                   String     @id @default(uuid())
  creditCardId         String
  transactionId        String? // Links to an expense Transaction (optional)
  closingDate          DateTime
  dueDate              DateTime
  totalAmount          Float
  status               BillStatus @default(pending)
  categorizationStatus String     @default("pending") // pending, processing, completed, failed
  csvFileName          String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  // Relations
  creditCard       CreditCard        @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  transaction      Transaction?      @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  billTransactions BillTransaction[]

  @@index([creditCardId])
  @@index([transactionId])
  @@index([status])
  @@index([dueDate])
  @@index([categorizationStatus])
  @@map("credit_card_bills")
}

// ============================================
// BILL TRANSACTION (line items from CSV)
// ============================================

model BillTransaction {
  id                String   @id @default(uuid())
  billId            String
  category          String
  transactionDate   DateTime
  description       String
  merchantName      String?
  amount            Float
  installmentNumber Int?
  totalInstallments Int?
  isAutoCategorized Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  bill        CreditCardBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  installment Installment?

  @@index([billId])
  @@index([category])
  @@index([transactionDate])
  @@map("bill_transactions")
}

// ============================================
// INSTALLMENT (parcela tracking)
// ============================================

model Installment {
  id                String   @id @default(uuid())
  creditCardId      String
  billTransactionId String   @unique
  description       String
  totalAmount       Float
  totalInstallments Int
  paidInstallments  Int      @default(0)
  startDate         DateTime
  installmentAmount Float
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  creditCard      CreditCard      @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  billTransaction BillTransaction @relation(fields: [billTransactionId], references: [id], onDelete: Cascade)

  @@index([creditCardId])
  @@index([isActive])
  @@map("installments")
}

// ============================================
// INVESTMENT ACCOUNT (broker/platform)
// ============================================

model InvestmentAccount {
  id          String     @id @default(uuid())
  userId      String
  name        String // e.g., "Interactive Brokers", "NuInvest", "Tesouro Direto"
  broker      String? // Broker identifier
  externalId  String? // Broker account number, when known (statement imports)
  entityType  EntityType
  currency    String     @default("BRL")
  cashBalance Float      @default(0) // Available cash in the account (not invested)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations - polymorphic association
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId        String?
  business          Business?           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  personalAccountId String?
  personalAccount   PersonalAccount?    @relation(fields: [personalAccountId], references: [id], onDelete: Cascade)
  holdings          InvestmentHolding[]
  transfersTo       Transfer[]          @relation("TransferToInvestment")
  transfersFrom     Transfer[]          @relation("TransferFromInvestment")

  @@index([userId])
  @@index([entityType])
  @@index([businessId])
  @@index([personalAccountId])
  @@map("investment_accounts")
}

// ============================================
// INVESTMENT HOLDING (position/asset)
// ============================================

model InvestmentHolding {
  id              String              @id @default(uuid())
  accountId       String
  assetClass      AssetClass
  subType         FixedIncomeSubType? // Only for fixed_income assets
  ticker          String? // For stocks, FIIs, crypto, ETFs (e.g., PETR4, HGLG11, BTC)
  name            String // Descriptive name (e.g., "CDB Nubank 120% CDI")
  currency        String              @default("BRL")
  currentQuantity Float               @default(0)
  averageCost     Float               @default(0)
  totalInvested   Float               @default(0)
  currentPrice    Float? // Latest market price per unit
  lastPriceUpdate DateTime? // When the price was last fetched
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // Relations
  account      InvestmentAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions InvestmentTransaction[]

  @@index([accountId])
  @@index([assetClass])
  @@index([ticker])
  @@index([isActive])
  @@map("investment_holdings")
}

// ============================================
// INVESTMENT TRANSACTION (buy/sell/dividend/yield)
// ============================================

model InvestmentTransaction {
  id           String                    @id @default(uuid())
  holdingId    String
  type         InvestmentTransactionType
  quantity     Float? // Number of units (for stocks, crypto, FIIs)
  pricePerUnit Float? // Price paid per unit (for stocks, crypto, FIIs)
  totalAmount  Float // Total cash value of the transaction
  fees         Float                     @default(0) // Brokerage fees, taxes
  date         DateTime
  notes        String?
  // Dedup key for statement imports. Native broker id when available;
  // otherwise a deterministic hash (see agent knowledge base
  // 20-dedup-rules.md) so re-uploading the same statement reconciles
  // cleanly instead of duplicating positions.
  externalId   String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  // Relations
  holding             InvestmentHolding @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  linkedTransactionId String?           @unique
  linkedTransaction   Transaction?      @relation(fields: [linkedTransactionId], references: [id], onDelete: SetNull)

  @@unique([holdingId, externalId])
  @@index([holdingId])
  @@index([type])
  @@index([date])
  @@index([externalId])
  @@map("investment_transactions")
}

// ============================================
// CURRENCY
// ============================================

model Currency {
  id         String   @id @default(uuid())
  userId     String
  code       String // ISO 4217 code (e.g., USD, EUR, BRL)
  name       String
  symbol     String
  manualRate Float    @default(1) // Rate relative to user's base currency
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId])
  @@map("currencies")
}

// ============================================
// MERCHANT CATEGORY MAPPING (learned categories)
// ============================================

model MerchantCategoryMapping {
  id                    String   @id @default(uuid())
  userId                String
  normalizedDescription String
  category              String
  source                String   @default("ai") // "manual" | "ai"
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedDescription])
  @@index([userId])
  @@map("merchant_category_mappings")
}

// ============================================
// STATEMENT IMPORT (bulk import job tracker)
// ============================================

model StatementImport {
  id                   String     @id @default(uuid())
  userId               String
  entityType           EntityType
  bankName             String?
  fileName             String?
  transactionCount     Int
  ledgerBalance        Float?
  ledgerCurrency       String?
  categorizationStatus String     @default("pending") // pending, processing, completed, failed
  // "manual" (existing wizard) or "agent" (assistant chat)
  source               String     @default("manual")
  revertedAt           DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  // Relations - polymorphic association
  businessId        String?
  business          Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  personalAccountId String?
  personalAccount   PersonalAccount? @relation(fields: [personalAccountId], references: [id], onDelete: Cascade)
  transactions      Transaction[]

  // Assistant linkage - set only when source == "agent"
  conversationId String?
  conversation   AgentConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  importPlanId   String?            @unique
  importPlan     ImportPlan?        @relation(fields: [importPlanId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([categorizationStatus])
  @@index([businessId])
  @@index([personalAccountId])
  @@index([conversationId])
  @@map("statement_imports")
}

// ============================================
// ATTACHMENT (bills, receipts, transfer proofs)
// ============================================

model Attachment {
  id           String         @id @default(uuid())
  kind         AttachmentKind
  blobUrl      String
  pathname     String
  mimeType     String
  sizeBytes    Int
  originalName String
  uploadedAt   DateTime       @default(now())

  // Polymorphic owner - exactly ONE of the following must be non-null
  transactionId          String?
  transaction            Transaction?          @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transferId             String?
  transfer               Transfer?             @relation(fields: [transferId], references: [id], onDelete: Cascade)
  recurringTransactionId String?
  recurringTransaction   RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: Cascade)
  recurringTransferId    String?
  recurringTransfer      RecurringTransfer?    @relation(fields: [recurringTransferId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([transferId])
  @@index([recurringTransactionId])
  @@index([recurringTransferId])
  @@index([kind])
  @@map("attachments")
}

// ============================================
// AI ASSISTANT (statement-sync chat agent)
//
// A conversation holds messages, uploaded statement files, and the
// import/revert plans the agent proposes from them. Domain writes only
// ever happen through ImportPlan.status == "committed", which itself
// requires "confirmed" - a state only the authenticated REST confirm
// endpoint can set (see modules/assistant/routes/v1/post-plan-confirm.ts).
// The agent's tool calls never reach Prisma directly; every tool wraps
// an existing module service, and every write is audited in AgentAction.
// ============================================

model AgentConversation {
  id            String                   @id @default(uuid())
  userId        String
  title         String?
  status        AgentConversationStatus  @default(active)
  lastMessageAt DateTime                 @default(now())
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages         AgentMessage[]
  turns            AgentTurn[]
  files            ConversationFile[]
  plans            ImportPlan[]
  actions          AgentAction[]
  statementImports StatementImport[]

  @@index([userId, lastMessageAt])
  @@map("agent_conversations")
}

model AgentMessage {
  id             String   @id @default(uuid())
  conversationId String
  turnId         String?
  role           String // "user" | "assistant" - wire format verbatim
  content        Json // Anthropic ContentBlockParam[] (text/document/tool_use/tool_result/thinking)
  kind           String // "user_text" | "assistant" | "tool_results" - UI block filtering
  createdAt      DateTime @default(now())

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  turn         AgentTurn?        @relation(fields: [turnId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([turnId])
  @@map("agent_messages")
}

model AgentTurn {
  id                       String          @id @default(uuid())
  conversationId           String
  status                   AgentTurnStatus @default(running)
  model                    String
  iterations               Int             @default(0)
  inputTokens              Int             @default(0)
  outputTokens             Int             @default(0)
  cacheCreationInputTokens Int             @default(0)
  cacheReadInputTokens     Int             @default(0)
  costUsd                  Decimal         @default(0) @db.Decimal(12, 6)
  durationMs               Int             @default(0)
  error                    String?
  createdAt                DateTime        @default(now())
  completedAt              DateTime?

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messages     AgentMessage[]
  actions      AgentAction[]

  @@index([conversationId])
  @@index([createdAt])
  @@map("agent_turns")
}

model ConversationFile {
  id             String            @id @default(uuid())
  conversationId String
  userId         String
  fileType       StatementFileType
  statementKind  String? // "bank_ofx" | "card_csv" | "investment_pdf" | "unknown"
  blobUrl        String
  pathname       String
  mimeType       String
  sizeBytes      Int
  originalName   String
  parseStatus    String            @default("pending") // pending | parsed | failed | not_applicable
  parsedPayload  Json? // ParsedStatement / parsed CSV rows - server-side cache for get_parsed_rows
  parseError     String?
  createdAt      DateTime          @default(now())

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  importPlans  ImportPlan[]

  @@index([conversationId])
  @@map("conversation_files")
}

model ImportPlan {
  id             String            @id @default(uuid())
  conversationId String
  userId         String
  kind           ImportPlanKind    @default(import)
  status         ImportPlanStatus  @default(proposed)
  entityType     EntityType?
  entityId       String?
  fileId         String?
  payload        Json // validated plan (transactions/transfers/investmentTransactions/...)
  payloadHash    String // sha256 of payload - the UI confirm endpoint echoes this back
  summary        Json // counts for the plan/duplicate-review cards
  warnings       Json              @default("[]")
  confirmedAt    DateTime?
  confirmedVia   String? // "ui_button"
  committedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  conversation    AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  file            ConversationFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  statementImport StatementImport?
  actions         AgentAction[]

  @@index([conversationId, status])
  @@map("import_plans")
}

model AgentAction {
  id             String   @id @default(uuid())
  userId         String
  conversationId String
  turnId         String?
  planId         String?
  toolName       String
  input          Json
  output         Json?
  status         String // "success" | "error"
  error          String?
  createdRecords Json? // [{model:"Transaction",id},{model:"Transfer",id},...] - powers revert
  durationMs     Int      @default(0)
  createdAt      DateTime @default(now())

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  turn         AgentTurn?        @relation(fields: [turnId], references: [id], onDelete: SetNull)
  plan         ImportPlan?       @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([planId])
  @@map("agent_actions")
}
