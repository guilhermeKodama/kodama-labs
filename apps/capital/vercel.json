{
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@wallex/capital",
  "crons": [
    {
      "path": "/api/cron/process-recurring",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/categorize-bills",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/categorize-statements",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/update-prices",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/update-rates",
      "schedule": "0 * * * *"
    }
  ]
}
