# Database. MUST point at a database whose name ends in _dev or _test
# outside of production - src/server/lib/db-guard.ts refuses to connect
# otherwise, and the db:* scripts refuse to run. Production is for end
# users only: never for tests, local scripts, or AI agents.
# There is no fallback value; a missing DATABASE_URL fails loudly.
DATABASE_URL="postgresql://root:root@localhost:5433/capital_dev"
DIRECT_URL="postgresql://root:root@localhost:5433/capital_dev"

# Optional: required only if cron routes enforce auth locally
CRON_SECRET="dev-secret"

# Optional integrations
# ANTHROPIC_API_KEY=
# BRAPI_TOKEN=

# Blob files live on disk. In production this path is the Docker volume mount.
CAPITAL_BLOB_DIR="/home/kodama/.local/share/capital/blob"

# Public app URL, inlined into the client bundle at build time.
# The production image takes this from the CAPITAL_PUBLIC_URL build arg
# (default https://capital.kodamalabs.ai).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-only origin for blob URLs written at request time. When set, it
# overrides NEXT_PUBLIC_APP_URL without a rebuild. Compose sets it from
# CAPITAL_PUBLIC_URL. Leave unset for local dev.
# APP_URL="https://capital.kodamalabs.ai"

# Web Push (reminder notifications).
# Gerar com: pnpm exec web-push generate-vapid-keys (par PRÓPRIO — não reusar o de outro app)
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:guilherme.kodama@gmail.com"

# MCP Server (remote AI assistant access)
# Generate a secure random token for production (e.g., openssl rand -hex 32)
MCP_API_KEY=""
# The Capital user ID that the MCP server will operate as
MCP_USER_ID=""

# Demo user of `pnpm db:seed:demo` (dev databases only). These are the
# seed's defaults; the email must end in @capital.test, because the seed
# deletes and recreates that user.
# DEMO_USER_EMAIL="demo@capital.test"
# DEMO_USER_PASSWORD="capital-demo-2026"
