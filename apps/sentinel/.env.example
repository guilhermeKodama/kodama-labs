DATABASE_URL="postgresql://root:root@localhost:5433/sentinel"
DIRECT_URL="postgresql://root:root@localhost:5433/sentinel"

# Optional: required only if cron routes enforce auth locally
CRON_SECRET="dev-secret"

# Optional integrations
# ANTHROPIC_API_KEY=
# TRANSPARENCIA_API_KEY=

# Blob files live on disk. In production this path is the Docker volume mount
# on sentinel-web (the only container that reads or writes them).
SENTINEL_BLOB_DIR="/home/kodama/.local/share/sentinel/blob"

# Public app URL, inlined into blob URLs. The production image takes this
# from the SENTINEL_PUBLIC_URL build arg (default https://sentinel.kodamalabs.ai).
NEXT_PUBLIC_APP_URL="http://localhost:3002"
