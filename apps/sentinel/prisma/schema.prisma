generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// ENUMS
// ============================================

enum DataSource {
  PNCP
  TRANSPARENCIA
  COMPRAS_GOV
  CEIS
  CNEP
  TCU
  CNPJ
  MARKET_PRICE
  TSE
  CAMARA
  SENADO
  CAMARA_LEGISLATIVE
  STF
  CURATED
  NEWS
}

enum JobStatus {
  IDLE
  RUNNING
  COMPLETED
  FAILED
}

enum AlertType {
  OVERPRICING
  SHELL_COMPANY
  SANCTIONED_ENTITY
  SUSPICIOUS_NETWORK
  AI_FLAG
  POLITICAL_LINK
  LEGAL_HISTORY
  VOTING_INCOHERENCE
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SanctionSource {
  CEIS
  CNEP
  TCU
}

// ============================================
// LAYER 1: RAW INGESTION
// ============================================

model IngestionCursor {
  id            String     @id @default(cuid())
  source        DataSource
  endpoint      String
  lastFetchedAt DateTime
  cursorValue   String?
  totalFetched  Int        @default(0)
  status        JobStatus  @default(IDLE)
  lastError     String?
  updatedAt     DateTime   @updatedAt

  @@unique([source, endpoint])
  @@map("ingestion_cursors")
}

model RawRecord {
  id              String     @id @default(cuid())
  source          DataSource
  recordType      String
  externalId      String
  data            Json
  fetchedAt       DateTime   @default(now())
  processedAt     DateTime?
  processingError String?

  @@unique([source, recordType, externalId])
  @@index([source, recordType, processedAt])
  // The two indexes below carry SQL clauses (INCLUDE / WHERE) that Prisma's
  // schema syntax cannot express. They are created in
  // migrations/20260516115212_add_raw_records_perf_indexes/migration.sql.
  // `prisma migrate dev` will detect drift and try to drop the clauses —
  // when that happens, delete the auto-generated migration and keep the
  // hand-edited one. Don't remove these @@index lines.
  @@index([source, recordType], map: "raw_records_breakdown_idx")
  @@index([recordType, source, fetchedAt], map: "raw_records_pending_idx")
  @@map("raw_records")
}

// ============================================
// LAYER 2: PROCESSED DATA
// ============================================

model Procurement {
  id          String     @id @default(cuid())
  externalId  String     @unique
  source      DataSource
  orgCnpj     String
  orgName     String
  orgPower    String?
  orgSphere   String?
  unitName    String?
  unitCode    String?
  ibgeCode    String?
  year        Int
  number      String
  sequencial  Int?
  modality    String
  modalityId  Int?
  description String
  publishedAt DateTime
  status      String
  statusId    Int?

  estimatedValue Decimal?
  approvedValue  Decimal?
  totalValue     Decimal?

  processo              String?
  legalBasis            String?
  legalBasisDescription String?
  disputeMode           String?
  disputeModeId         Int?
  isSrp                 Boolean?
  instrumentType        String?
  instrumentTypeId      Int?
  proposalOpenDate      DateTime?
  proposalCloseDate     DateTime?
  confidentialBudget    Boolean   @default(false)
  linkOrigem            String?
  linkProcesso          String?
  budgetSources         Json?

  itemsEnrichedAt     DateTime?
  documentsEnrichedAt DateTime?

  state       String?
  city        String?
  riskScore   Float?
  processedAt DateTime @default(now())
  rawRecordId String?

  items     ProcurementItem[]
  contracts Contract[]
  alerts    Alert[]
  analyses  AiAnalysis[]
  documents ProcurementDocument[]

  @@index([orgCnpj])
  @@index([state, city])
  @@index([publishedAt])
  @@index([riskScore])
  @@index([itemsEnrichedAt])
  @@index([documentsEnrichedAt])
  @@index([publishedAt(sort: Desc), id])
  @@map("procurements")
}

model ProcurementDocument {
  id            String     @id @default(cuid())
  externalId    String     @unique
  procurementId String
  source        DataSource
  sequencial    Int
  title         String
  documentType  String
  mimeType      String
  sizeBytes     Int
  contentHash   String?
  sourceUrl     String?
  storageBucket String?
  storageKey    String?
  statusAtivo   Boolean    @default(true)
  publishedAt   DateTime?
  fetchedAt     DateTime   @default(now())
  rawRecordId   String?

  procurement Procurement @relation(fields: [procurementId], references: [id], onDelete: Cascade)

  @@index([procurementId])
  @@index([documentType])
  @@index([fetchedAt])
  @@map("procurement_documents")
}

model ProcurementItem {
  id            String  @id @default(cuid())
  externalId    String  @unique
  procurementId String
  itemNumber    Int
  description   String
  quantity      Decimal
  unitPrice     Decimal
  totalPrice    Decimal
  unit          String
  catmatCode    String?
  ncmCode       String?
  catalogCode   String?

  materialOrService     String?
  materialOrServiceName String?
  situationId           Int?
  situationName         String?
  judgmentCriteria      String?
  judgmentCriteriaId    Int?
  benefitType           String?
  hasResult             Boolean @default(false)

  procurement     Procurement      @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  bidResults      BidResult[]
  priceReferences PriceReference[]
  priceAnalyses   PriceAnalysis[]

  @@index([catmatCode])
  @@index([ncmCode])
  @@index([procurementId])
  @@map("procurement_items")
}

model BidResult {
  id           String  @id @default(cuid())
  itemId       String
  sequencial   Int
  supplierCnpj String
  supplierName String
  supplierSize String?
  supplierType String?
  countryCode  String?

  unitPrice  Decimal
  totalPrice Decimal
  quantity   Decimal?
  discount   Float?
  ranking    Int?

  isSubcontracted Boolean   @default(false)
  resultDate      DateTime?
  situationId     Int?
  situationName   String?

  item ProcurementItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, sequencial])
  @@index([supplierCnpj])
  @@index([itemId])
  @@map("bid_results")
}

model Contract {
  id                    String  @id @default(cuid())
  externalId            String  @unique
  procurementId         String?
  procurementExternalId String?

  orgCnpj   String?
  orgName   String?
  unitName  String?
  unitState String?
  unitCity  String?

  supplierCnpj    String
  supplierName    String
  supplierType    String?
  supplierCountry String?

  objectDescription String?
  categoryName      String?
  categoryId        Int?
  contractType      String?
  contractTypeId    Int?
  processo          String?
  contractNumber    String?

  value            Decimal
  initialValue     Decimal?
  globalValue      Decimal?
  installmentValue Decimal?
  installmentCount Int?
  accumulatedValue Decimal?

  signatureDate DateTime?
  startDate     DateTime
  endDate       DateTime?
  publishedAt   DateTime?

  amendmentCount Int     @default(0)
  isRevenue      Boolean @default(false)

  subcontractorCnpj String?
  subcontractorName String?

  year       Int?
  sequencial Int?

  documentsEnrichedAt DateTime?

  description String
  rawRecordId String?

  entity      Entity             @relation(fields: [supplierCnpj], references: [cnpj])
  procurement Procurement?       @relation(fields: [procurementId], references: [id])
  alerts      Alert[]
  documents   ContractDocument[]

  @@index([supplierCnpj])
  @@index([orgCnpj])
  @@index([procurementId])
  @@index([startDate])
  @@index([publishedAt])
  @@index([startDate(sort: Desc), id])
  @@index([documentsEnrichedAt])
  @@map("contracts")
}

model ContractDocument {
  id            String     @id @default(cuid())
  externalId    String     @unique
  contractId    String
  source        DataSource
  sequencial    Int
  title         String
  documentType  String
  mimeType      String
  sizeBytes     Int
  contentHash   String?
  sourceUrl     String?
  storageBucket String?
  storageKey    String?
  statusAtivo   Boolean    @default(true)
  publishedAt   DateTime?
  fetchedAt     DateTime   @default(now())
  rawRecordId   String?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([documentType])
  @@index([fetchedAt])
  @@map("contract_documents")
}

model Entity {
  id             String    @id @default(cuid())
  cnpj           String    @unique
  name           String
  tradeName      String?
  legalNature    String?
  openDate       DateTime?
  capital        Decimal?
  activityCode   String?
  activityDesc   String?
  address        String?
  state          String?
  city           String?
  employeeCount  Int?
  riskScore      Float?
  isShellCompany Boolean   @default(false)
  enrichedAt     DateTime?
  rawRecordId    String?

  shareholders   Shareholder[]
  contracts      Contract[]
  sanctions      Sanction[]
  alerts         Alert[]
  politicalLinks PoliticalLink[]

  @@index([state, city])
  @@index([riskScore])
  @@index([isShellCompany])
  // Matches the entities listing orderBy: (riskScore DESC NULLS LAST, id ASC).
  // The NULLS LAST modifier cannot be expressed in Prisma's @@index syntax, so
  // the index is created via hand-edited SQL in
  // migrations/20260606000000_add_listing_perf_indexes/migration.sql.
  // `prisma migrate dev` will detect drift and try to drop NULLS LAST — when
  // that happens, delete the auto-generated migration and keep the hand-edited
  // one. Don't remove this @@index line.
  @@index([riskScore(sort: Desc), id], map: "entities_riskScore_id_listing_idx")
  @@map("entities")
}

model Shareholder {
  id       String  @id @default(cuid())
  entityId String
  name     String
  cpfCnpj  String?
  role     String

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([cpfCnpj])
  @@index([entityId])
  @@map("shareholders")
}

model Sanction {
  id         String         @id @default(cuid())
  externalId String?        @unique
  entityId   String?
  cnpjCpf    String
  personName String?
  personType String?
  source     SanctionSource
  type       String
  reason     String
  startDate  DateTime
  endDate    DateTime?

  sanctionType         String?
  legalBasis           String?
  sanctioningOrg       String?
  sanctioningOrgState  String?
  sanctioningOrgPower  String?
  sanctioningOrgSphere String?
  processNumber        String?
  publicationDate      DateTime?
  transitDate          DateTime?
  originDate           DateTime?

  rawRecordId String?

  entity Entity? @relation(fields: [entityId], references: [id])

  @@index([cnpjCpf])
  @@index([entityId])
  @@index([source])
  @@index([endDate])
  @@map("sanctions")
}

model PriceReference {
  id        String   @id @default(cuid())
  itemId    String
  source    String
  price     Decimal
  fetchedAt DateTime
  url       String?

  item ProcurementItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("price_references")
}

// ============================================
// LAYER 3: ANALYSIS
// ============================================

model PriceAnalysis {
  id             String   @id @default(cuid())
  itemId         String
  medianGovPrice Decimal?
  avgMarketPrice Decimal?
  deviation      Float
  method         String
  isOverpriced   Boolean
  details        Json
  analyzedAt     DateTime @default(now())

  item ProcurementItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([isOverpriced])
  @@map("price_analyses")
}

model Alert {
  id            String    @id @default(cuid())
  type          AlertType
  severity      Severity
  title         String
  description   String
  procurementId String?
  contractId    String?
  entityId      String?
  data          Json
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  procurement Procurement? @relation(fields: [procurementId], references: [id])
  contract    Contract?    @relation(fields: [contractId], references: [id])
  entity      Entity?      @relation(fields: [entityId], references: [id])

  @@index([type])
  @@index([severity])
  @@index([createdAt])
  @@index([procurementId])
  @@index([contractId])
  @@index([entityId])
  @@map("alerts")
}

model AiAnalysis {
  id            String   @id @default(cuid())
  targetType    String
  targetId      String
  analysisType  String
  prompt        String
  response      String
  riskScore     Float
  findings      Json
  model         String
  tokens        Int?
  createdAt     DateTime @default(now())
  procurementId String?

  procurement Procurement? @relation(fields: [procurementId], references: [id])

  @@index([targetType, targetId])
  @@index([analysisType])
  @@index([createdAt])
  @@map("ai_analyses")
}

// ============================================
// LAYER 2b: POLITICAL DATA
// ============================================

model Politician {
  id              String    @id @default(cuid())
  cpf             String    @unique
  name            String
  ballotName      String?
  party           String?
  position        String
  state           String?
  city            String?
  electionYear    Int?
  elected         Boolean   @default(false)
  active          Boolean   @default(false)
  photoUrl        String?
  externalId      String?
  rawRecordId     String?
  birthDate       DateTime?
  birthState      String?
  birthCity       String?
  gender          String?
  education       String?
  maritalStatus   String?
  occupation      String?
  email           String?
  familyFetchedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  donations CampaignDonation[]
  links     PoliticalLink[]
  assets    CandidateAsset[]
  servants  PublicServant[]
  relatives PoliticianRelative[]

  candidacies           Candidacy[]
  parliamentaryExpenses ParliamentaryExpense[]
  authoredBills         BillAuthorship[]
  votes                 LegislativeVote[]
  committeeRoles        CommitteeMembership[]
  termHistory           MandateTerm[]
  partyChanges          PartyAffiliationChange[]
  stances               PolicyStance[]
  legalProceedings      LegalProceeding[]
  scorecards            PoliticianScorecard[]
  news                  PoliticianNews[]

  @@index([cpf])
  @@index([party])
  @@index([state])
  @@index([position])
  @@index([active, elected, name, id])
  // Matches the politicians listing orderBy:
  // (active DESC, elected DESC, name ASC, id ASC). The existing
  // [active, elected, name, id] index is all-ASC and cannot serve this scan
  // forward or backward, forcing a sort over the whole result set.
  @@index([active(sort: Desc), elected(sort: Desc), name, id], map: "politicians_listing_idx")
  @@map("politicians")
}

model CampaignDonation {
  id           String   @id @default(cuid())
  politicianId String
  donorName    String
  donorCpfCnpj String
  donorType    String?
  amount       Decimal
  electionYear Int
  description  String?
  rawRecordId  String?
  createdAt    DateTime @default(now())

  donorNameRfb      String?
  donorCnae         String?
  donorState        String?
  donorCity         String?
  donationDate      DateTime?
  receiptNumber     String?
  originType        String?
  sourceType        String?
  speciesType       String?
  candidateName     String?
  candidateParty    String?
  candidatePosition String?
  state             String?

  politician Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  @@index([donorCpfCnpj])
  @@index([politicianId])
  @@index([donorState])
  @@map("campaign_donations")
}

model PoliticalLink {
  id            String   @id @default(cuid())
  politicianId  String
  entityId      String?
  shareholderId String?
  contractId    String?
  linkType      String
  description   String
  strength      Float    @default(0.5)
  data          Json
  createdAt     DateTime @default(now())

  politician Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)
  entity     Entity?    @relation(fields: [entityId], references: [id])

  @@index([politicianId])
  @@index([entityId])
  @@index([linkType])
  @@map("political_links")
}

model CandidateAsset {
  id           String   @id @default(cuid())
  politicianId String
  assetType    String
  description  String
  value        Decimal
  electionYear Int
  rawRecordId  String?
  createdAt    DateTime @default(now())

  politician Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  @@index([politicianId])
  @@index([electionYear])
  @@map("candidate_assets")
}

model PublicServant {
  id           String    @id @default(cuid())
  politicianId String
  cpf          String
  cargo        String?
  funcao       String?
  orgao        String?
  orgaoCode    String?
  situacao     String?
  remuneracao  Decimal?
  dataAdmissao DateTime?
  rawRecordId  String?
  createdAt    DateTime  @default(now())

  politician Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  @@index([politicianId])
  @@index([cpf])
  @@map("public_servants")
}

model PoliticianRelative {
  id           String   @id @default(cuid())
  politicianId String
  relativeCpf  String
  relativeName String
  relationship String
  confidence   Float?
  rawRecordId  String?
  createdAt    DateTime @default(now())

  politician Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  @@unique([politicianId, relativeCpf])
  @@index([relativeCpf])
  @@map("politician_relatives")
}

// ============================================
// JOBS
// ============================================

model JobRun {
  id          String    @id @default(cuid())
  jobName     String
  layer       String
  status      JobStatus
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  recordsIn   Int?
  recordsOut  Int?
  error       String?
  metadata    Json?

  @@index([jobName])
  @@index([layer])
  @@index([startedAt])
  @@map("job_runs")
}

// ============================================
// LAYER 2c: ELECTIONS 2026 — CANDIDACY & PARLIAMENTARY SPENDING
// ============================================

model Candidacy {
  id           String     @id @default(cuid())
  politicianId String
  electionYear Int
  position     String?
  state        String?
  ballotNumber String?
  party        String?
  coalition    String?
  status       String // INCUMBENT | PRESUMED | OFFICIAL | WITHDRAWN | REJECTED
  result       String? // ELEITO | NAO_ELEITO | 2_TURNO | null
  source       DataSource
  rawRecordId  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  politician Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  @@unique([politicianId, electionYear])
  @@index([electionYear, status])
  @@index([politicianId])
  @@map("candidacies")
}

model ParliamentaryExpense {
  id           String    @id @default(cuid())
  politicianId String
  house        String // CAMARA | SENADO
  year         Int
  month        Int
  category     String // código estável → codes.ceapCategory
  supplierName String
  supplierDoc  String? // CNPJ/CPF do fornecedor — cruza com Entity.cnpj/Sanction/Contract
  amount       Decimal
  documentDate DateTime?
  documentId   String? // codDocumento (chave natural)
  documentUrl  String?
  rawRecordId  String?
  createdAt    DateTime  @default(now())

  politician Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  @@unique([house, documentId])
  @@index([politicianId])
  @@index([politicianId, year, month])
  @@index([category])
  @@index([supplierDoc])
  @@map("parliamentary_expenses")
}

// ============================================
// LAYER 2d: LEGISLATIVE ACTIVITY
// ============================================

model LegislativeProposal {
  id          String    @id @default(cuid())
  house       String
  externalId  String
  type        String
  number      Int?
  year        Int?
  title       String
  themes      String[]
  summary     String?
  presentedAt DateTime?
  status      String?
  rawRecordId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  authorships BillAuthorship[]
  votes       LegislativeVote[]

  @@unique([house, externalId])
  @@index([type, year])
  @@map("legislative_proposals")
}

model BillAuthorship {
  id           String   @id @default(cuid())
  politicianId String
  proposalId   String
  role         String   @default("AUTHOR") // AUTHOR | COAUTHOR | RAPPORTEUR
  createdAt    DateTime @default(now())

  politician Politician          @relation(fields: [politicianId], references: [id], onDelete: Cascade)
  proposal   LegislativeProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([politicianId, proposalId, role])
  @@index([politicianId])
  @@index([proposalId])
  @@map("bill_authorships")
}

model LegislativeVote {
  id             String    @id @default(cuid())
  politicianId   String
  votacaoId      String
  proposalId     String?
  house          String
  vote           String // SIM | NAO | ABSTENCAO | OBSTRUCAO | AUSENTE → codes.voteDirection
  votacaoDate    DateTime?
  votacaoTitle   String?
  orientationGov String? // orientação do governo (p/ gov_alignment)
  rawRecordId    String?
  createdAt      DateTime  @default(now())

  politician Politician           @relation(fields: [politicianId], references: [id], onDelete: Cascade)
  proposal   LegislativeProposal? @relation(fields: [proposalId], references: [id])

  @@unique([politicianId, votacaoId])
  @@index([politicianId])
  @@index([votacaoId])
  @@index([proposalId])
  @@map("legislative_votes")
}

model CommitteeMembership {
  id           String    @id @default(cuid())
  politicianId String
  house        String
  committee    String
  role         String // TITULAR | SUPLENTE | PRESIDENTE | RELATOR
  startDate    DateTime?
  endDate      DateTime?
  rawRecordId  String?
  createdAt    DateTime  @default(now())

  politician Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  @@index([politicianId])
  @@index([committee])
  @@map("committee_memberships")
}

model MandateTerm {
  id           String    @id @default(cuid())
  politicianId String
  house        String
  legislature  Int
  position     String
  state        String?
  party        String?
  startDate    DateTime?
  endDate      DateTime?
  rawRecordId  String?
  createdAt    DateTime  @default(now())

  politician Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  @@unique([politicianId, legislature, house])
  @@index([politicianId])
  @@map("mandate_terms")
}

model PartyAffiliationChange {
  id           String    @id @default(cuid())
  politicianId String
  fromParty    String?
  toParty      String
  changeDate   DateTime?
  rawRecordId  String?
  createdAt    DateTime  @default(now())

  politician Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  @@index([politicianId])
  @@map("party_affiliation_changes")
}

// ============================================
// LAYER 2e: DISCURSO × AÇÃO (curated key votes + declared stances)
// ============================================

model KeyVote {
  id                 String   @id @default(cuid())
  slug               String   @unique
  theme              String // código → codes.theme
  label              String
  description        String
  house              String
  votacaoExternalId  String? // liga a LegislativeVote.votacaoId
  proposalExternalId String?
  favorableVote      String // qual voto (SIM/NAO) conta como "a favor da pauta"
  createdAt          DateTime @default(now())

  @@index([theme])
  @@map("key_votes")
}

model PolicyStance {
  id           String     @id @default(cuid())
  politicianId String
  theme        String // código → codes.theme
  stance       String // FAVOR | CONTRA | NEUTRO
  source       DataSource // CURATED | TSE | CAMARA
  confidence   Float?
  verifiedBy   String? // "manual" | "ai:<model>" | "tse-proposta"
  sourceUrl    String?
  rawRecordId  String?
  createdAt    DateTime   @default(now())

  politician Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  @@unique([politicianId, theme, source])
  @@index([politicianId])
  @@map("policy_stances")
}

// ============================================
// LAYER 3b: LEGAL HISTORY, SCORECARDS & NEWS
// ============================================

model LegalProceeding {
  id              String     @id @default(cuid())
  politicianId    String
  kind            String // CRIMINAL | IMPROBIDADE | ELECTORAL | REJECTED_ACCOUNTS | INELIGIBILITY | CIVIL
  status          String // INVESTIGATION | INDICTED | CONVICTED_1ST | CONVICTED_APPEAL | ACQUITTED | ARCHIVED | SERVING_SENTENCE
  court           String?
  caseNumber      String?
  title           String
  description     String?
  decisionDate    DateTime?
  isFinal         Boolean    @default(false) // trânsito em julgado
  makesIneligible Boolean    @default(false) // Lei da Ficha Limpa
  source          DataSource // TSE | TCU | STF | CURATED
  confidence      Float?
  verifiedBy      String?
  sourceUrl       String?
  rawRecordId     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  politician Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  @@index([politicianId])
  @@index([kind])
  @@index([status])
  @@index([makesIneligible])
  @@map("legal_proceedings")
}

model PoliticianScorecard {
  id           String   @id @default(cuid())
  politicianId String
  electionYear Int
  metric       String // gov_alignment | attendance_rate | wealth_growth | funding_mix | coherence_authorship | coherence_stance | expense_total | term_count | party_switches
  valueNum     Float?
  valueText    String?
  details      Json
  computedAt   DateTime @default(now())

  politician Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  @@unique([politicianId, electionYear, metric])
  @@index([politicianId])
  @@index([metric])
  @@map("politician_scorecards")
}

model PoliticianNews {
  id              String    @id @default(cuid())
  politicianId    String
  title           String
  url             String
  source          String // veículo normalizado contra a allowlist
  author          String?
  publishedAt     DateTime?
  snippet         String?
  imageUrl        String?
  themes          String[]
  matchConfidence Float? // confiança do match nome→político
  credibility     String? // TRUSTED | MIXED | LOW | UNKNOWN (da allowlist)
  factCheckStatus String    @default("UNVERIFIED") // UNVERIFIED | VERIFIED | DISPUTED | FALSE
  factCheckUrl    String?
  rawRecordId     String?
  createdAt       DateTime  @default(now())

  politician Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  @@unique([politicianId, url])
  @@index([politicianId, publishedAt])
  @@index([factCheckStatus])
  @@map("politician_news")
}
