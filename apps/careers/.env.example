DATABASE_URL="postgresql://root:root@localhost:5433/careers"
DIRECT_URL="postgresql://root:root@localhost:5433/careers"

# Claude API — haiku for bulk job scoring, opus for resume-suggestion generation.
ANTHROPIC_API_KEY=""
SCORE_MODEL="claude-haiku-4-5"
SUGGEST_MODEL="claude-opus-5"
LLM_TIMEOUT_MS=120000
# Soft daily cap on LLM spend (USD) — the score worker defers rather than fails once hit.
LLM_DAILY_BUDGET_USD=5

# Gerar com: pnpm exec web-push generate-vapid-keys (par PRÓPRIO — não reusar o do attention)
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:guilherme.kodama@gmail.com"

# Onde os arquivos enviados (currículos, docs de contexto) ficam guardados quando
# BLOB_READ_WRITE_TOKEN não está setado. Caminho absoluto fora do repo — não pode
# depender de qual checkout/worktree roda o processo (mesma lição do WHATSAPP_AUTH_DIR
# do attention: um valor relativo ao cwd quebra assim que o worker roda via systemd).
CAREERS_BLOB_DIR="/home/kodama/.local/share/careers/blob"
# Opcional: usar Vercel Blob em vez do disco local.
# BLOB_READ_WRITE_TOKEN=

# Caminho do vault do Obsidian, para o importador (src/scripts/import-vault.ts).
# Copie para disco local antes de rodar — o mount CIFS é lento demais pra parsear direto.
VAULT_VAGAS_DIR="/mnt/nas-shared/obsidian/kodama-vault/vagas"

# Máximo de vagas novas promovidas por rodada diária (mesmo cap do _config.yaml original).
MAX_JOBS_PER_DAY=10

NEXT_PUBLIC_APP_URL="http://localhost:3006"
