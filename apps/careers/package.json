{
  "name": "@wallex/careers",
  "version": "0.1.0",
  "description": "Job search tracking: search parameters, ranked applications, learned triage, resume versioning",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev --port 3006",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start --port 3006",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset --force",
    "worker:jobs": "node --env-file=.env --import tsx src/worker/jobs.ts",
    "worker:sources": "node --env-file=.env --import tsx src/worker/sources.ts",
    "worker:maintenance": "node --env-file=.env --import tsx src/worker/maintenance.ts",
    "import:vault": "node --env-file=.env --import tsx src/scripts/import-vault.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.73.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.0.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@repo/storage": "workspace:*",
    "@t3-oss/env-nextjs": "^0.11.0",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.563.0",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^1.5.0",
    "tailwind-merge": "^3.4.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^6.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
