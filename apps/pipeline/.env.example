# Database (local docker: infrastructure/postgres, port 5433)
DATABASE_URL=postgresql://root:root@localhost:5433/pipeline
DIRECT_URL=postgresql://root:root@localhost:5433/pipeline

# Cron auth (Vercel crons send Authorization: Bearer $CRON_SECRET)
CRON_SECRET=dev-secret

# Ideas sync (GitHub Action / pnpm sync:ideas send Authorization: Bearer $SYNC_SECRET)
SYNC_SECRET=dev-sync-secret

# Lead webhook HMAC — same value as LEADS_WEBHOOK_SECRET on each idea's LP
WEBHOOK_HMAC_SECRET=dev-webhook-secret

# Dashboard basic auth (leave empty in local dev to disable)
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Meta Marketing API — system user token (Never expiring, scopes: ads_read + business_management)
META_SYSTEM_USER_TOKEN=

# Google Ads API (developer token in the MCC's API Center; OAuth app MUST be published to production)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# GA4 Data API — base64 of the service-account JSON key (base64 -i key.json | tr -d '\n')
GA4_SA_KEY_BASE64=

NEXT_PUBLIC_APP_URL=http://localhost:3004
