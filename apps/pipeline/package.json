{
  "name": "@wallex/pipeline",
  "version": "0.1.0",
  "description": "Funnel metrics dashboard for validation ideas — spend, sessions, leads, CAC and go/kill health",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev --port 3004",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start --port 3004",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run"
  },
  "dependencies": {
    "@google-analytics/data": "^6.1.0",
    "@hono/zod-openapi": "^0.18.0",
    "@prisma/client": "^6.0.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@scalar/hono-api-reference": "^0.5.0",
    "@t3-oss/env-nextjs": "^0.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "echarts": "^6.1.0",
    "google-ads-api": "^23.0.0",
    "hono": "^4.6.0",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.563.0",
    "next": "16.2.9",
    "next-intl": "^4.8.1",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.8",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^1.5.0",
    "stoker": "^1.0.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^6.0.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "3.2.4"
  }
}
